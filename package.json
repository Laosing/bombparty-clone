{
  "name": "@laosing/bombparty-clone",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently 'node index.js' 'cd client && pnpm install && pnpm start'",
    "start": "node index.js",
    "build": "cd client && pnpm install && pnpm build",
    "deploy": "fly deploy --remote-only",
    "test": "cd client && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "concurrently": "^9.1.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~4.4.0",
    "dotenv": "^16.0.1",
    "eslint": "^9.26.0",
    "express": "~5.1.0",
    "morgan": "~1.10.0",
    "nanoid": "^5.1.5",
    "nodemon": "^3.1.10",
    "pino": "^9.6.0",
    "serialize-javascript": "^6.0.2",
    "socket.io": "^4.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

{
  "name": "@laosing/bombparty-clone",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/server.ts & (cd client && bun install && bun start)",
    "build": "cd client && bun install && bun build",
    "start": "bun src/server.ts",
    "deploy": "fly deploy --remote-only",
    "test": "bun test tests/ && cd client && bun run test"
  },
  "dependencies": {
    "@socket.io/bun-engine": "^0.0.1",
    "nanoid": "^5.1.5",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.1",
    "superjson": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/bun": "latest"
  }
}

{
  "name": "@laosing/bombparty-clone",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently 'bun src/server.ts' 'cd client && bun install && bun start'",
    "build": "cd client && bun install && bun build",
    "start": "bun src/server.ts",
    "deploy": "fly deploy --remote-only",
    "test": "cd client && bun test"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "debug": "~4.4.0",
    "dotenv": "^16.0.1",
    "eslint": "^9.26.0",
    "nanoid": "^5.1.5",
    "nodemon": "^3.1.10",
    "pino": "^9.6.0",
    "superjson": "^1.13.0",
    "socket.io": "^4.8.1",
    "@socket.io/bun-engine": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/bun": "latest",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
